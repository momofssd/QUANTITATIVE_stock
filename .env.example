# Alpaca credentials (https://app.alpaca.markets -> API Keys)
ALPACA_API_KEY=your_key_id
ALPACA_SECRET_KEY=your_secret_key
# Trading endpoint: paper or live
ALPACA_ENDPOINT=https://paper-api.alpaca.markets
# Market data feed:
#   auto = SIP history (back to 2016, full volume) + IEX for the latest 15 min on free plans; SIP everywhere on paid plans
#   iex  = IEX only (history from mid-2020)
#   sip  = SIP only (paid plan)
ALPACA_DATA_FEED=auto
